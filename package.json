{
  "name": "dsh-session-delete",
  "version": "0.2.0",
  "description": "Permanently delete DSH sessions from disk, plus workspace-level archive-all / delete-all — right from the sidebar row menu. Updated for DSH >= 0.2.0-rc.2 menu DOM changes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RightFS/dsh-session-delete.git"
  },
  "homepage": "https://github.com/RightFS/dsh-session-delete#readme",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "delete",
    "session-delete",
    "deepseek-harness"
  ]
}